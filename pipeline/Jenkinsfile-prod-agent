                                    return checkIsRunStage("mocksite", params['Components'])
                                }
                            }
                            steps {
                                 dir('mocksite') {                                    
                                    sh "sudo docker build --build-arg BuildEnv=prod_gpi -t registry.gitlab.com/rayprosoft/turnkey-gaming-system/mocksite:prod-${params['Version']} ."
                                    sh "sudo docker build --build-arg BuildEnv=prod_gpi -t registry.gitlab.com/rayprosoft/turnkey-gaming-system/mocksite:prod ."
