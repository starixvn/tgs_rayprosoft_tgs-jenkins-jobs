                        stage('clone agent') {
                            when {
                                expression {
                                    return checkIsRunStage("agent-gpi", params['Components'])
                                }
                            }
                            steps {
                                dir('agent') { 
                                    git branch: "master", url: 'https://gitlab.com/inwoker/tgs/tgs-affiliate.git' , credentialsId: 'gitlab-user-pwd'
                                }
