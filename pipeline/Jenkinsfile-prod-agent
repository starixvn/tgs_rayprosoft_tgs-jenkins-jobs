def deployedComponents = ""

pipeline {
    agent any
	
	environment {
		Registry = "registry.gitlab.com/rayprosoft/turnkey-gaming-system/backoffice-site"
		gitlab_user_pwd = credentials('gitlab-user-pwd')
	}
	stages {
	    stage('Clear') {
