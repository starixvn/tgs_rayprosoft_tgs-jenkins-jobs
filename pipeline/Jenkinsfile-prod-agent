			}
		}
	    stage('Build Docker Images') {
            parallel {
                stage('backoffice-site') {
                    stages {
                        stage('clone backoffice') {
                            when {
                                expression {
                                    return checkIsRunStage("backoffice-site", params['Components'])
                                }
                            }
                            steps {
                                dir('backoffice') { 
