                            }
                            steps {
                                 dir('agent') {                                    
                                    sh "sudo docker build --build-arg BuildEnv=prod_gpi -t registry.gitlab.com/rayprosoft/turnkey-gaming-system/agent-gpi:prod-${params['Version']} ."
