                                    sh "sudo docker push registry.gitlab.com/rayprosoft/turnkey-gaming-system/agent-gpi:prod-${params['Version']}"
                                    sh "sudo docker push registry.gitlab.com/rayprosoft/turnkey-gaming-system/agent-gpi:prod"
									//deployedComponents += "agent-gpi:prod"
