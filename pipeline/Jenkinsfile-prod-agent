                                }
                            }
                        }
                        stage('build backoffice') {
                            when {
                                expression {
                                    return checkIsRunStage("backoffice-site", params['Components'])
                                }
                            }
                            steps {
                                 dir('backoffice') {                                    
                                    sh "sudo docker build --build-arg BuildEnv=prod_gpi -t registry.gitlab.com/rayprosoft/turnkey-gaming-system/backoffice-site:prod-${params['Version']} ."
                                    sh "sudo docker build --build-arg BuildEnv=prod_gpi -t registry.gitlab.com/rayprosoft/turnkey-gaming-system/backoffice-site:prod ."
                                    sh "sudo docker push registry.gitlab.com/rayprosoft/turnkey-gaming-system/backoffice-site:prod-${params['Version']}"
                                    sh "sudo docker push registry.gitlab.com/rayprosoft/turnkey-gaming-system/backoffice-site:prod"
									//deployedComponents += "backoffice-site:prod"
                                }
                            }
                        }
                    }
                }
                stage('mocksite') {
                    stages {
                        stage('clone mocksite') {
                            when {
                                expression {
                                    return checkIsRunStage("mocksite", params['Components'])
                                }
                            }
                            steps {
                                dir('mocksite') { 
                                    git branch: "main", url: 'https://gitlab.com/rayprosoft/tgs-website-mocksite.git' , credentialsId: 'gitlab-user-pwd'
                                }
                            }
                        }
                        stage('build mocksite') {
                            when {
